{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "module": "es2022",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.js", "src/**/*.d.ts", "prompts/**/*.js"]
}
